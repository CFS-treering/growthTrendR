# RStudio project files
^.*\.Rproj$
^\.Rproj\.user$

# GitHub / version control
^\.github

# Documentation folders
^doc/
^docs/
^Meta/
^inst/publication$

# Vignettes - remove all .R, .html, cache and figure folders, keep only .Rmd
^vignettes/.*\.R$
^vignettes/.*\.html$
^vignettes/_cache/
^vignettes/_files/

# inst/rmd - remove all .R, .html, cache and figure folders, keep only .Rmd
^inst/rmd/.*\.R$
^inst/rmd/.*\.html$
^inst/rmd/_cache/
^inst/rmd/_files/

# Optional: ignore specific vignettes if needed
^vignettes/vgn.*

